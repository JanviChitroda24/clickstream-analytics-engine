# ClickStream Analytics Engine — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Fabric Eventstream connection (from Eventstream → Custom App source)
EVENTSTREAM_CONNECTION_STR=Endpoint=sb://your-eventstream.servicebus.windows.net/;SharedAccessKeyName=...;SharedAccessKey=...;EntityPath=...
EVENTSTREAM_NAME=clickstream_eventstream

# Fabric Eventhouse (KQL) — for scripts/run_kql.py command-line runner
# Query URI: Fabric → clickstream_eventhouse → database details → "Query URI"
# Auth is via `az login` (Azure CLI), so no key/secret is needed here.
KUSTO_URI=https://trd-xxxxxxxxxx.z.kusto.fabric.microsoft.com
KUSTO_DATABASE=clickstream_eventhouse
