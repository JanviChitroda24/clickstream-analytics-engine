# ClickStream Analytics Engine — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Fabric Eventstream connection (from Eventstream → Custom App source)
EVENTSTREAM_CONNECTION_STR=Endpoint=sb://your-eventstream.servicebus.windows.net/;SharedAccessKeyName=...;SharedAccessKey=...;EntityPath=...
EVENTSTREAM_NAME=clickstream_eventstream
